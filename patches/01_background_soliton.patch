diff --git a/include/background.h b/include/background.h
index abc1234..def5678 100644
--- a/include/background.h
+++ b/include/background.h
@@ -100,6 +100,7 @@ struct background {
   double * Omega0_b; /**< array of Omega0_b at each time */
   double * Omega0_cdm; /**< array of Omega0_cdm at each time */
   double * Omega0_k; /**< array of Omega0_k at each time */
 +  double * Omega0_soliton; /**< array of Omega0_soliton at each time (ADMST) */
    
   /** @name - quantities related to time */
 @@ -200,6 +201,15 @@ struct background {
   double Omega0_dcdmdr; /**< today's density parameter of decay products of dcdm */
   double Omega0_scf; /**< today's density parameter of scalar field (if there is one) */
   double Omega0_ur; /**< today's density parameter of ultra-relativistic species / radiation (photons + massless neutrinos) */
 +
 +  /* ADMST Soliton Gas Parameters */
 +  double Omega0_soliton; /**< today's soliton density parameter */
 +  double Gamma_soliton; /**< soliton production/decay rate [1/Mpc] */
 +  double cs2_soliton; /**< soliton sound speed squared */
 +  double T_soliton_star; /**< characteristic temperature [GeV] */
 +  double m_soliton; /**< soliton mass [GeV] */
 +  double alpha_gamma_phi; /**< soliton-photon coupling */
 +  double xi_thermal; /**< thermalization parameter */
 };
diff --git a/source/background.c b/source/background.c
index abc1234..def5678 100644
--- a/source/background.c
+++ b/source/background.c
@@ -500,6 +500,13 @@ int Background::background_solve() {
     pvecback[pba->index_bi_rho_dcdm] = 0.;
     pvecback[pba->index_bi_p_dcdm] = 0.;
   }
 +
 +  /* ADMST: Initialize soliton gas */
 +  if (pba->has_soliton == _TRUE_) {
 +    pvecback[pba->index_bi_rho_soliton] = pba->Omega0_soliton * pba->H0 * pba->H0 / pow(a,3);
 +    pvecback[pba->index_bi_p_soliton] = pba->cs2_soliton * pvecback[pba->index_bi_rho_soliton];
 +  }
 +
   /* ... rest of initialization ... */
 }
